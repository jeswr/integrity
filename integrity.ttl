# @jeswr/integrity vocabulary — https://jeswr.org/ns/integrity#
# GENERATED by scripts/gen-vocab-ttl.mjs from src/vocab.ts + src/profiles.ts — do not hand-edit.
# Run `npm run build && node scripts/gen-vocab-ttl.mjs` to regenerate after a vocab/profile change.

@prefix integrity: <https://jeswr.org/ns/integrity#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<https://jeswr.org/ns/integrity> a owl:Ontology;
    dct:title "The @jeswr/integrity vocabulary"@en;
    dct:description "Integrity properties, IL0-IL4 profiles, and orthogonal add-on flags for the @jeswr/integrity abstraction seam. Mirrors the STRUCTURE of the private sparq security & integrity ontologies (sec-prop / sig-impl / sec-req); term-level owl:equivalent* alignment is pending their public-flip (sparq-org/sparq#1682) — see https://github.com/jeswr/integrity/blob/main/ALIGNMENT.md."@en;
    owl:versionInfo "0.1.0".
integrity:IntegrityProperty a owl:Class;
    rdfs:label "Integrity Property"@en;
    rdfs:comment "A named property a mechanism may attain (yes), partially attain (partial), or fail (no). Mirrors the sparq sec-prop:SecurityProperty pattern."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:IntegrityProfile a owl:Class;
    rdfs:label "Integrity Profile"@en;
    rdfs:comment "A named, reusable set of (property, minimum verdict) demands — the IL0-IL4 ladder. NOT an ordinal enum: profiles happen to nest, add-ons are orthogonal. Mirrors the sparq sec-req:Requirement 'pulls on properties' pattern."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:Addon a owl:Class;
    rdfs:label "Integrity Add-on"@en;
    rdfs:comment "An orthogonal single-property demand composed into any base IntegrityProfile (e.g. +Unlinkability)."@en;
    rdfs:subClassOf integrity:IntegrityProfile;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:requires a rdf:Property;
    rdfs:label "requires"@en;
    rdfs:comment "Links an IntegrityProfile/Addon to one (property, minimum verdict) requirement node."@en;
    rdfs:domain integrity:IntegrityProfile;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:onProperty a rdf:Property;
    rdfs:label "on property"@en;
    rdfs:comment "The IntegrityProperty a requirement node pulls on."@en;
    rdfs:range integrity:IntegrityProperty;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:minVerdict a rdf:Property;
    rdfs:label "minimum verdict"@en;
    rdfs:comment "The minimum Verdict demanded — one of \"yes\", \"partial\", \"no\" (sparq sig-impl:Assertion enum)."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:TransportOriginAuth a rdf:Property, integrity:IntegrityProperty;
    rdfs:label "Transport Origin Auth"@en;
    rdfs:comment "Integrity/origin assured only for the retrieval channel (TLS, DPoP-bound); does not survive copying. PROPOSED base property — not yet in sparq sec-prop:."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:ContentBinding a rdf:Property, integrity:IntegrityProperty;
    rdfs:label "Content Binding"@en;
    rdfs:comment "The artifact is bound to a specific canonical content (RDFC-1.0 digest / bytes hash). PROPOSED base property — not yet in sparq sec-prop:."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:TamperEvidence a rdf:Property, integrity:IntegrityProperty;
    rdfs:label "Tamper Evidence"@en;
    rdfs:comment "Any post-attestation modification is detectable by a holder. PROPOSED base property — not yet in sparq sec-prop:."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:AuthorshipBinding a rdf:Property, integrity:IntegrityProperty;
    rdfs:label "Authorship Binding"@en;
    rdfs:comment "The content is bound to an identified key/identity (issuer / WebID). PROPOSED base property — not yet in sparq sec-prop:."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:OfflineVerifiability a rdf:Property, integrity:IntegrityProperty;
    rdfs:label "Offline Verifiability"@en;
    rdfs:comment "Verification needs no callback to the origin at check time. PROPOSED base property — not yet in sparq sec-prop:."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:RevocationFreshness a rdf:Property, integrity:IntegrityProperty;
    rdfs:label "Revocation Freshness"@en;
    rdfs:comment "Validity window + status (revocation / suspension) checked, fail-closed. PROPOSED base property — not yet in sparq sec-prop:."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:Unlinkability a rdf:Property, integrity:IntegrityProperty;
    rdfs:label "Unlinkability"@en;
    rdfs:comment "Multiple presentations of the same credential/content cannot be linked to one another (category: informationDisclosure). Aligns to the private sparq sec-prop:Unlinkability term (owl:equivalentProperty pending sparq-org/sparq#1682)."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:SourceCredentialDisclosure a rdf:Property, integrity:IntegrityProperty;
    rdfs:label "Source Credential Disclosure"@en;
    rdfs:comment "The verifier learns no more about the source credential than the disclosed claims — selective disclosure (category: informationDisclosure). Aligns to the private sparq sec-prop:SourceCredentialDisclosure term (owl:equivalentProperty pending sparq-org/sparq#1682)."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:PostQuantumForgery a rdf:Property, integrity:IntegrityProperty;
    rdfs:label "Post-Quantum Forgery Resistance"@en;
    rdfs:comment "Resistant to forgery by a quantum-capable adversary (category: formalAnalysisPriority). Aligns to the private sparq sec-prop:PostQuantumForgery term (owl:equivalentProperty pending sparq-org/sparq#1682)."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:PostQuantumSnooping a rdf:Property, integrity:IntegrityProperty;
    rdfs:label "Post-Quantum Snooping Resistance"@en;
    rdfs:comment "Resistant to retroactive decryption/linkage by a quantum-capable adversary — harvest-now-decrypt-later (category: formalAnalysisPriority). Aligns to the private sparq sec-prop:PostQuantumSnooping term (owl:equivalentProperty pending sparq-org/sparq#1682)."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:SignatureTypeLeakage a rdf:Property, integrity:IntegrityProperty;
    rdfs:label "Signature Type Leakage Resistance"@en;
    rdfs:comment "The signature/proof does not reveal which cryptosuite or algorithm produced it (category: informationDisclosure). Aligns to the private sparq sec-prop:SignatureTypeLeakage term (owl:equivalentProperty pending sparq-org/sparq#1682)."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:ProofSizeLeakage a rdf:Property, integrity:IntegrityProperty;
    rdfs:label "Proof Size Leakage Resistance"@en;
    rdfs:comment "The proof size does not reveal information about the underlying claims (category: informationDisclosure). Aligns to the private sparq sec-prop:ProofSizeLeakage term (owl:equivalentProperty pending sparq-org/sparq#1682)."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:ValidityPeriodLeakage a rdf:Property, integrity:IntegrityProperty;
    rdfs:label "Validity Period Leakage Resistance"@en;
    rdfs:comment "The validity period does not reveal information beyond what is disclosed (category: informationDisclosure). Aligns to the private sparq sec-prop:ValidityPeriodLeakage term (owl:equivalentProperty pending sparq-org/sparq#1682)."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:CircuitAudit a rdf:Property, integrity:IntegrityProperty;
    rdfs:label "Circuit Audit"@en;
    rdfs:comment "The mechanism's circuit/implementation has undergone (or requires) an independent audit (category: deploymentSpec). Aligns to the private sparq sec-prop:CircuitAudit term (owl:equivalentProperty pending sparq-org/sparq#1682)."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:IL0-none a integrity:IntegrityProfile;
    rdfs:label "IL0-none"@en;
    rdfs:comment "No integrity properties demanded — the null profile."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>.
integrity:IL1-transport a integrity:IntegrityProfile;
    rdfs:label "IL1-transport"@en;
    rdfs:comment "Transport-only integrity: TransportOriginAuth at `yes`. Off the IL2 nesting chain."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>;
    integrity:requires _:n3-0.
_:n3-0 integrity:onProperty integrity:TransportOriginAuth;
    integrity:minVerdict "yes".
integrity:IL2-content-bound a integrity:IntegrityProfile;
    rdfs:label "IL2-content-bound"@en;
    rdfs:comment "Content-bound: ContentBinding + TamperEvidence + OfflineVerifiability all at `yes`, given a trusted reference."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>;
    integrity:requires _:n3-1.
_:n3-1 integrity:onProperty integrity:ContentBinding;
    integrity:minVerdict "yes".
integrity:IL2-content-bound integrity:requires _:n3-2.
_:n3-2 integrity:onProperty integrity:TamperEvidence;
    integrity:minVerdict "yes".
integrity:IL2-content-bound integrity:requires _:n3-3.
_:n3-3 integrity:onProperty integrity:OfflineVerifiability;
    integrity:minVerdict "yes".
integrity:IL3-author-bound a integrity:IntegrityProfile;
    rdfs:label "IL3-author-bound"@en;
    rdfs:comment "IL2 plus AuthorshipBinding at `yes`."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>;
    integrity:requires _:n3-4.
_:n3-4 integrity:onProperty integrity:ContentBinding;
    integrity:minVerdict "yes".
integrity:IL3-author-bound integrity:requires _:n3-5.
_:n3-5 integrity:onProperty integrity:TamperEvidence;
    integrity:minVerdict "yes".
integrity:IL3-author-bound integrity:requires _:n3-6.
_:n3-6 integrity:onProperty integrity:OfflineVerifiability;
    integrity:minVerdict "yes".
integrity:IL3-author-bound integrity:requires _:n3-7.
_:n3-7 integrity:onProperty integrity:AuthorshipBinding;
    integrity:minVerdict "yes".
integrity:IL4-author-bound-fresh a integrity:IntegrityProfile;
    rdfs:label "IL4-author-bound-fresh"@en;
    rdfs:comment "IL3 plus RevocationFreshness at `yes`."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>;
    integrity:requires _:n3-8.
_:n3-8 integrity:onProperty integrity:ContentBinding;
    integrity:minVerdict "yes".
integrity:IL4-author-bound-fresh integrity:requires _:n3-9.
_:n3-9 integrity:onProperty integrity:TamperEvidence;
    integrity:minVerdict "yes".
integrity:IL4-author-bound-fresh integrity:requires _:n3-10.
_:n3-10 integrity:onProperty integrity:OfflineVerifiability;
    integrity:minVerdict "yes".
integrity:IL4-author-bound-fresh integrity:requires _:n3-11.
_:n3-11 integrity:onProperty integrity:AuthorshipBinding;
    integrity:minVerdict "yes".
integrity:IL4-author-bound-fresh integrity:requires _:n3-12.
_:n3-12 integrity:onProperty integrity:RevocationFreshness;
    integrity:minVerdict "yes".
integrity:SelectiveDisclosureAddon a integrity:Addon;
    rdfs:label "+SelectiveDisclosure"@en;
    rdfs:comment "Orthogonal add-on: demands SourceCredentialDisclosure at minimum `partial`."@en;
    rdfs:isDefinedBy <https://jeswr.org/ns/integrity>;
    integrity:requires _:n3-13.
_:n3-13 integrity:onProperty integrity:SourceCredentialDisclosure;
    integrity:minVerdict "partial".
